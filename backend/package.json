{
  "name": "gurukela-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js + Express + MySQL API for the gurukela.lk LMS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:admin": "node src/db/create-admin.js",
    "db:reset": "node src/db/migrate.js --fresh && node src/db/seed.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3"
  }
}

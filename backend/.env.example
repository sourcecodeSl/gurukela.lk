# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (frontend dev + prod)
CORS_ORIGIN=http://localhost:5173,http://localhost

# ---- Database (XAMPP MySQL defaults) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gurukela_lms

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_MINUTES=10
# In development the OTP is printed to the server console instead of being sent.
OTP_DEV_LOG=true

# ---- SMS gateway ----
# Supported providers: "dev" (console log), "ozonesender", "textlk", "http" (generic)
SMS_PROVIDER=dev

# OzoneSender (https://api.ozonesender.com) — GET with query params, 204 = success
# SMS_PROVIDER=ozonesender
SMS_API_URL=https://api.ozonesender.com/v1/send/
SMS_USER_ID=
SMS_API_KEY=
SMS_SENDER_ID=Gurukela

# Text.lk (https://app.text.lk) — REST API v3, OAuth 2.0 Bearer token, POST JSON.
# SMS_API_KEY holds your Text.lk API token; SMS_SENDER_ID is your approved sender.
# SMS_API_URL is optional (defaults to the v3 send endpoint below).
# SMS_PROVIDER=textlk
# SMS_API_URL=https://app.text.lk/api/v3/sms/send

# For provider=http only: METHOD is GET or POST, and the placeholders
# {to}, {text}, {sender}, {apikey} are substituted into SMS_API_URL.
SMS_HTTP_METHOD=GET
# Example: https://gateway.example.lk/send?api_key={apikey}&to={to}&sender={sender}&message={text}

# ---- Business rules ----
DEFAULT_COMMISSION_RATE=0.15

# ---- Dialog Genie payment gateway ----
# Leave blank to run in SANDBOX mode (no real charge; bookings still complete
# so the flow is testable). Fill in for production and set GENIE_LIVE=true.
GENIE_API_URL=
GENIE_API_KEY=
GENIE_MERCHANT_ID=
GENIE_LIVE=false

# ---- PayHere payment gateway ----
# Create a (free) sandbox account at https://sandbox.payhere.lk and add a
# Domain/App to get your Merchant Secret; Merchant ID is on the dashboard.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Public URL PayHere posts to for confirmation. On localhost use an ngrok URL,
# e.g. https://<id>.ngrok-free.app/api/payments/payhere/notify . Blank = derive
# from the request host (only works when the backend is publicly reachable).
PAYHERE_NOTIFY_URL=
# Frontend base URL for return/cancel redirects.
APP_URL=http://localhost:5173

# ---- Zoom in-site live classes ----
# Leave blank to disable Zoom (the live-class buttons are hidden).
# 1) Meeting SDK app (Marketplace > Build App > Meeting SDK): gives the embed
#    credentials used to sign each join request.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
# 2) Server-to-Server OAuth app (Marketplace > Build App > Server-to-Server
#    OAuth): used to create meetings via the API and fetch the host start token.
#    Scopes: meeting:write:admin, user:read:admin (and user_zak:read if listed).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Base URL of the backend API.
#
# Leave this UNSET for local development — the app then calls the relative
# `/api` path, which the Vite dev server proxies to http://localhost:4000
# (see vite.config.js). That keeps everything on one origin, so there is no
# CORS step to configure.
#
# Set it only when the API lives somewhere else, e.g. a deployed environment:
# VITE_API_URL=https://gurukela-api.sourcecode.lk/api

# @zoom/meetingsdk pins react@18.2.0 as a peer, but the app uses react@18.3.1.
# The SDK's Component View bundles its own React, so the mismatch is harmless.
# This lets `npm ci` / `npm install` (incl. the GitHub Action deploy) resolve
# without an ERESOLVE peer-dependency error.
legacy-peer-deps=true

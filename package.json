{
  "name": "gurukela-lk",
  "version": "0.1.0",
  "private": true,
  "description": "gurukela.lk LMS — frontend (React/Vite) + backend (Node/Express/MySQL)",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,green --handle-input \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "db:reset": "npm --prefix backend run db:reset",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
